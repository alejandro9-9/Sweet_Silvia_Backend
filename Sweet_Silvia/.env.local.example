# Copy to .env for local Docker Compose. Use only Izipay test credentials here.
Izipay__Enabled=true
Izipay__BaseUrl=https://api.micuentaweb.pe/api-payment
Izipay__PaymentEndpoint=V4/Charge/CreatePayment
Izipay__ShopId=CHANGE_ME_TEST_SHOP_ID
Izipay__Password=CHANGE_ME_TEST_REST_PASSWORD
Izipay__HmacSha256Key=CHANGE_ME_TEST_HMAC_SHA256_KEY
Izipay__PublicKey=CHANGE_ME_TEST_PUBLIC_KEY
# Point an HTTPS tunnel (for example Cloudflare Tunnel/ngrok) to localhost:8080.
Izipay__NotificationUrl=https://your-tunnel.trycloudflare.com/api/payments/izipay/notifications
Izipay__Environment=Sandbox

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
PORT=8080

ConnectionStrings__SweetSilviaDatabase=Host=YOUR_RDS_ENDPOINT;Port=5432;Database=sweet_silvia;Username=YOUR_RDS_USER;Password=YOUR_RDS_PASSWORD;SSL Mode=VerifyFull;Root Certificate=/app/rds-global-bundle.pem
Database__ApplyMigrationsOnStartup=true

Jwt__Issuer=SweetSilvia
Jwt__Audience=SweetSilvia
Jwt__SecretKey=CHANGE_ME_WITH_A_REAL_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__ExpirationMinutes=30

RefreshToken__ExpirationDays=30

# Keep disabled until the production frontend origin is registered in Google Cloud.
Google__Enabled=false
Google__ClientId=CHANGE_ME_WITH_GOOGLE_WEB_CLIENT_ID
Google__ClientSecret=
Google__RedirectUri=

EmailVerification__CodeExpirationMinutes=10
EmailVerification__ResendCooldownSeconds=60

Email__Provider=Brevo
Email__ApiKey=CHANGE_ME_WITH_BREVO_API_KEY
Email__From=verified-sender@example.com
Email__FromName=Sweet Silvia

Olva__BaseUrl=https://api.olva-api.lat
Olva__ApiKey=CHANGE_ME_WITH_OLVA_API_KEY

# Keep disabled until the frontend and notification endpoint are publicly deployed.
Izipay__Enabled=false
Izipay__BaseUrl=https://sandbox-api-pw.izipay.pe
Izipay__TokenEndpoint=security/v1/Token/Generate
Izipay__PaymentLinkEndpoint=paymentlink/api/v1/process/generate
Izipay__MerchantCode=CHANGE_ME_WITH_IZIPAY_MERCHANT_CODE
Izipay__ApiKey=CHANGE_ME_WITH_IZIPAY_PAYMENT_API_KEY
# Required by the hosted checkout/SDK when the integration mode uses the public RSA key.
Izipay__PublicKey=
Izipay__HashKey=CHANGE_ME_WITH_IZIPAY_HASH_KEY
Izipay__NotificationUrl=https://your-api-domain.com/api/payments/izipay/notifications
Izipay__TermsAndConditionsUrl=https://your-frontend-domain.com/terms-and-conditions
Izipay__Environment=Sandbox

# ECS tasks are ephemeral. Use separate S3 buckets so receipts never share the public catalog origin.
FileStorage__Provider=S3
FileStorage__S3PublicBucketName=sweet-silvia-public-assets
FileStorage__S3PrivateBucketName=sweet-silvia-private-receipts
FileStorage__S3Region=us-east-1
FileStorage__S3PublicBaseUrl=https://your-cloudfront-domain.com

Roles__CustomerRoleId=11111111-1111-1111-1111-111111111111

Cors__AllowedOrigins__0=https://your-production-frontend.com
